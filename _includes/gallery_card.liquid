<article class="gallery-card">
  {% if include.post.thumbnail %}
    <a
      class="gallery-card-image"
      href="{{ include.post.url | relative_url }}"
      aria-label="View {{ include.post.title }}"
    >
      <img
        src="{{ include.post.thumbnail | relative_url }}"
        alt="{{ include.post.title }}"
        loading="lazy"
      >
    </a>
  {% endif %}

  <div class="gallery-card-content">
    <time
      class="gallery-card-date"
      datetime="{{ include.post.date | date_to_xmlschema }}"
    >
      {{ include.post.date | date: '%B %Y' }}
    </time>

    <h3 class="gallery-card-title">
      <a href="{{ include.post.url | relative_url }}">
        {{ include.post.title }}
      </a>
    </h3>

    {% if include.post.description %}
      <p class="gallery-card-description">
        {{ include.post.description }}
      </p>
    {% endif %}

    <a
      class="gallery-card-link"
      href="{{ include.post.url | relative_url }}"
    >
      View gallery →
    </a>
  </div>
</article>
