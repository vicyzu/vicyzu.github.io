<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    {% assign news = site.news | reverse %}

    {% if include.limit and page.announcements.limit %}
      {% assign news_limit = page.announcements.limit %}
    {% else %}
      {% assign news_limit = news_size %}
    {% endif %}

    <div
      class="news-list"
      {% if include.limit and page.announcements.scrollable and news_size > 3 %}
        style="max-height: 60vw; overflow-y: auto;"
      {% endif %}
    >
      {% for item in news limit: news_limit %}
        {% if item.inline %}
          <div class="news-inline-item">
            <div class="news-date">
              {{ item.date | date: '%b %d, %Y' }}
            </div>

            <div class="news-inline-content">
              {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
            </div>
          </div>

        {% else %}
          <article class="news-card">
            {% if item.thumbnail %}
              <div class="news-card-image">
                <a href="{{ item.url | relative_url }}">
                  <img
                    src="{{ item.thumbnail | relative_url }}"
                    alt="{{ item.title }}"
                    loading="lazy"
                  >
                </a>
              </div>
            {% endif %}

            <div class="news-card-content">
              <div class="news-date">
                {{ item.date | date: '%b %d, %Y' }}
              </div>

              <h3 class="news-card-title">
                <a href="{{ item.url | relative_url }}">
                  {{ item.title }}
                </a>
              </h3>

              {% if item.description %}
                <p class="news-card-description">
                  {{ item.description }}
                </p>
              {% endif %}

              <a class="news-read-more" href="{{ item.url | relative_url }}"> Read more → </a>
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>

  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
